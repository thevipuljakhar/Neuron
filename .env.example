# Copy this file to ".env" (same folder as neuron.py) and fill in real values.
# .env is read at boot and must NEVER be committed or shared.

# Brain Centers master key — protects /api/brain/* endpoints
# Choose any strong passphrase; share only with yourself.
NEURON_MASTER_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional NVIDIA NIM keys (LLM synthesis + rerank); blank ⇒ heuristic fallback.
NVIDIA_API_KEY_MAIN=
NVIDIA_API_KEY_RERANK=
# Optional OpenWeatherMap key (https://home.openweathermap.org/api_keys) — adds
# current cloud/temp/wind to the RE-hub weather. Blank ⇒ open-meteo only.
OPENWEATHER_API_KEY=
# Optional (P20) macro/trade. IMF DataMapper is keyless (always on). These two
# light up extra metrics only when set; absent ⇒ honest gap, never fabricated.
EIA_API_KEY=
TRADINGECONOMICS_KEY=
